{
  "name": "code-sandbox",
  "version": "0.1.6",
  "description": "Code Sandbox - run code online via WASM",
  "scripts": {
    "build": "npm run build:esbuild",
    "build:esbuild": "node esbuild.mjs prod",
    "build:esbuild:watch": "node esbuild.mjs dev watch",
    "build:watch": "npm run build:esbuild:watch",
    "lint:tsc": "tsc .",
    "lint:prettier": "prettier -c .",
    "lint:prettier:write": "prettier -w .",
    "test": "npm run test:unit && npm run test:functional",
    "test:functional": "jest -c jest.config.functional.ts",
    "test:unit": "jest -c jest.config.unit.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dom111/code-sandbox.git"
  },
  "author": "Dom Hastings <dom111@users.noreply.github.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/dom111/code-sandbox/issues"
  },
  "homepage": "https://github.com/dom111/code-sandbox#readme",
  "dependencies": {
    "@wasmer/sdk": "^0.6.0",
    "codemirror": "^5.65.0",
    "coi-serviceworker": "^0.1.7",
    "eventemitter3": "^5.0.1",
    "melba-toast": "^2.0.0",
    "xterm": "^4.16.0",
    "xterm-addon-fit": "^0.5.0"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.5",
    "@types/jest": "^29.5.12",
    "@types/puppeteer": "^5.4.5",
    "esbuild": "^0.20.2",
    "esbuild-sass-plugin": "^3.0.0",
    "jest": "^29.7.0",
    "jest-puppeteer": "^10.0.1",
    "prettier": "^2.5.1",
    "puppeteer": "^22.8.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.7.0"
  }
}
